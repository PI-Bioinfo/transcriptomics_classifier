process {

    withName: 'DESEQ2|CLASSIFICATION|FEATURE_SELECTION_PADJ|XGBOOST|RANDOM_FOREST' {
        publishDir = [
            path: { "${params.outdir}/${params.data_type}/" },
            mode: params.publish_dir_mode,
        ]
    }
    
    withName: 'PREPROCESS' {
        ext.sampling_ratio      = 0.8
        ext.sampling_seed       = 1
    }
}